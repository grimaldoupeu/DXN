# Configuración de Base de Datos
# Para desarrollo local usamos SQLite (cero configuración).
# Para producción en Vercel, cambia el 'provider' a 'postgresql' en prisma/schema.prisma y usa tu URL de Supabase/Neon.
DATABASE_URL="file:./dev.db"

# Teléfono de la distribuidora de DXN para recibir pedidos por WhatsApp (con código de país sin el signo +, ej: 51987654321)
NEXT_PUBLIC_WHATSAPP_PHONE="51987654321"

# Contraseña secreta para acceder al panel de administración (/admin)
ADMIN_PASSWORD="tu_contrasena_aqui"

# Token de encriptación para las cookies de sesión
JWT_SECRET="un_secreto_largo_y_seguro_para_firmar_sesiones"
